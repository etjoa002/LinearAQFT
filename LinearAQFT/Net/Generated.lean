import LinearAQFT.Net.Basic
import LocalAlgebrasLean.Net.Generated
import BosonicLean.CStar.Commute
import Mathlib.Analysis.CStarAlgebra.Hom

/-!
# Generated nets

The net generated by a monotone family of subsets `G O` of a C*-algebra assigns to `O` the
C*-subalgebra generated by `G O`. Each of the axioms of [Dimock] except primitivity then follows
from a statement about the generators alone. The key input is that closed star algebras generated
by mutually commuting sets commute.

## Main statements

* `BosonicLean.commute_of_mem_topologicalClosure_adjoin` (milestone A, Lemma 7; moved to
  BosonicLean on 29 Sep 2026).
* `LinearAQFT.Net.generated` (Definition 8) and its four properties (Proposition 9):
  `generated_isCausal`, `generated_hasTimeSlice`, `generated_isGenerating`,
  `generated_isCovariancePair`.
-/

namespace LinearAQFT

open StarAlgebra StarSubalgebra

variable {A : Type*} [CStarAlgebra A]

namespace Net

variable {R R' : Type*} [Preorder R] [Preorder R'] {A' : Type*} [CStarAlgebra A']

/-- Milestone A, Definition 8: the net generated by a monotone family of subsets of `A` (the
generated net of LocalAlgebrasLean). -/
abbrev generated (G : R →o Set A) : Net R A := LocalAlgebrasLean.Net.generated G

theorem generated_apply (G : R →o Set A) (O : R) :
    generated G O = (adjoin ℂ (G O)).topologicalClosure := rfl

theorem subset_generated (G : R →o Set A) (O : R) : G O ⊆ generated G O :=
  LocalAlgebrasLean.Net.subset_generated G O

/-- Milestone A, Proposition 9(a): causality from commuting generators. -/
theorem generated_isCausal (C : CausalIndex R) (G : R →o Set A)
    (h : ∀ ⦃O₁ O₂ : R⦄, C.Orthogonal O₁ O₂ →
      ∀ a ∈ G O₁, ∀ b ∈ G O₂, Commute a b ∧ Commute a (star b)) :
    IsCausal C (generated G) := fun _ _ hO _ ha _ hb =>
  BosonicLean.commute_of_mem_topologicalClosure_adjoin (fun a ha b hb => (h hO a ha b hb).1)
    (fun a ha b hb => (h hO a ha b hb).2) ha hb

/-- Milestone A, Proposition 9(b): time slice from generators lying in the later algebra. -/
theorem generated_hasTimeSlice (C : CausalIndex R) (G : R →o Set A)
    (h : ∀ ⦃O O' : R⦄, C.Dependent O O' → G O ⊆ generated G O') :
    HasTimeSlice C (generated G) := fun _ O' hO =>
  topologicalClosure_minimal (adjoin_le (h hO)) ((generated G).isClosed O')

/-- Milestone A, Proposition 9(c): generation from generators. -/
theorem generated_isGenerating (G : R →o Set A)
    (h : (adjoin ℂ (⋃ O, G O)).topologicalClosure = ⊤) :
    IsGenerating (generated G) :=
  LocalAlgebrasLean.Net.generated_isGenerating G h

/-- Milestone A, Proposition 9(d): a star isomorphism mapping generators onto generators gives
a covariance pair of the generated nets. -/
theorem generated_isCovariancePair {C : CausalIndex R} {C' : CausalIndex R'} (G : R →o Set A)
    (G' : R' →o Set A') (κ : C.Iso C') (α : A ≃⋆ₐ[ℂ] A')
    (h : ∀ O, α '' G O = G' (κ O)) :
    IsCovariancePair (generated G) (generated G') κ α :=
  LocalAlgebrasLean.Net.generated_isCovariancePair G G' κ.toIso α h

end Net

end LinearAQFT
