import LinearAQFT.Causal.Basic
import LocalAlgebrasLean.Net.Basic
import BosonicLean.CStar.Primitive
import Mathlib.Analysis.CStarAlgebra.Classes
import Mathlib.Analysis.CStarAlgebra.ContinuousLinearMap
import Mathlib.Topology.Algebra.StarSubalgebra

/-!
# Nets of C*-algebras and their axioms

A net assigns to each region a norm-closed star subalgebra of a fixed unital C*-algebra,
monotonically in the region (isotony). The axioms of [Dimock] (Commun. Math. Phys. 77 (1980)
219–228, §1) are stated here as properties of a net relative to a causal index: generation,
causality, time slice, primitivity of the ambient algebra, and covariance.

A net does not refer to the causal index; the axioms do. So one net can be tested against
several causal structures on the same regions.

Since milestone L2 of LocalAlgebrasLean (6 Oct 2026) the net and the axioms that do not involve
the dependence relation are those of that library: `LinearAQFT.Net` is `LocalAlgebrasLean.Net`,
causality (N2) is its local commutativity for the region index underlying the causal index, and a
covariance pair is one for the underlying isomorphism of region indices. The names and statements
of milestone A are kept; the time slice (N3) is defined here.

## Main definitions

* `LinearAQFT.Net R A`: a net over regions `R` in the C*-algebra `A`.
* `LinearAQFT.Net.IsGenerating`, `LinearAQFT.Net.IsCausal`, `LinearAQFT.Net.HasTimeSlice`.
* Axiom 2 uses `BosonicLean.IsPrimitive` (with `BosonicLean.IsIrreducibleRep`), moved to
  BosonicLean on 30 Sep 2026.
* `LinearAQFT.Net.IsCovariancePair`, `LinearAQFT.Net.Isomorphic`,
  `LinearAQFT.Net.IsCovariantUnder`.
-/

universe u

namespace LinearAQFT

open CausalIndex

/-- A net (milestone A, Definition 3): a monotone assignment of norm-closed star subalgebras of
`A` to regions. Monotonicity is isotony. It is the net of LocalAlgebrasLean. -/
abbrev Net (R : Type*) [Preorder R] (A : Type*) [CStarAlgebra A] := LocalAlgebrasLean.Net R A

namespace Net

variable {R R' R'' : Type*} [Preorder R] [Preorder R'] [Preorder R'']
variable {A A' A'' : Type*} [CStarAlgebra A] [CStarAlgebra A'] [CStarAlgebra A'']

theorem mono (𝒜 : Net R A) {O O' : R} (h : O ≤ O') : 𝒜 O ≤ 𝒜 O' :=
  LocalAlgebrasLean.Net.mono 𝒜 h

/-- (N1) Generation: the C*-subalgebra generated by all local algebras is `A`. -/
abbrev IsGenerating (𝒜 : Net R A) : Prop :=
  LocalAlgebrasLean.Net.IsGenerating 𝒜

/-- (N2) Causality: local algebras of orthogonal regions commute (local commutativity for the
region index underlying `C`). -/
abbrev IsCausal (C : CausalIndex R) (𝒜 : Net R A) : Prop :=
  LocalAlgebrasLean.Net.IsLocallyCommutative C.toRegionIndex 𝒜

/-- (N3) Time slice: if `O` is causally dependent on `O'`, the local algebra of `O` is
contained in that of `O'`. -/
def HasTimeSlice (C : CausalIndex R) (𝒜 : Net R A) : Prop :=
  ∀ ⦃O O' : R⦄, C.Dependent O O' → 𝒜 O ≤ 𝒜 O'

/-- A covariance pair (milestone A, Definition 5): an isomorphism `κ` of causal indices and a
star isomorphism `α` with `α (𝒜 O) = 𝒜' (κ O)` for every region `O`. -/
abbrev IsCovariancePair {C : CausalIndex R} {C' : CausalIndex R'} (𝒜 : Net R A)
    (𝒜' : Net R' A') (κ : C.Iso C') (α : A ≃⋆ₐ[ℂ] A') : Prop :=
  LocalAlgebrasLean.Net.IsCovariancePair 𝒜 𝒜' κ.toIso α

/-- Two nets over the same causal index are isomorphic (Dimock, p. 220) if a star isomorphism
of the ambient algebras maps each local algebra onto the corresponding one. -/
def Isomorphic (C : CausalIndex R) (𝒜 : Net R A) (𝒜' : Net R A') : Prop :=
  ∃ α : A ≃⋆ₐ[ℂ] A', IsCovariancePair 𝒜 𝒜' (CausalIndex.Iso.refl C) α

/-- Covariance under a group `Γ` acting on the causal index through `κ` and on `A` through
`α`, both group homomorphisms: every `(κ γ, α γ)` is a covariance pair. -/
def IsCovariantUnder {Γ : Type*} [Group Γ] {C : CausalIndex R} (𝒜 : Net R A)
    (κ : Γ →* C.Aut) (α : Γ →* (A ≃⋆ₐ[ℂ] A)) : Prop :=
  ∀ γ, IsCovariancePair 𝒜 𝒜 (κ γ) (α γ)

variable {C : CausalIndex R} {C' : CausalIndex R'} {C'' : CausalIndex R''}

/-- Milestone A, Lemma 6 (first part): the identity pair. -/
theorem isCovariancePair_refl (𝒜 : Net R A) :
    IsCovariancePair 𝒜 𝒜 (CausalIndex.Iso.refl C) (StarAlgEquiv.refl ℂ A) :=
  LocalAlgebrasLean.Net.isCovariancePair_refl 𝒜

/-- Milestone A, Lemma 6 (second part): covariance pairs compose. -/
theorem IsCovariancePair.trans {𝒜 : Net R A} {𝒜' : Net R' A'} {𝒜'' : Net R'' A''}
    {κ₁ : C.Iso C'} {α₁ : A ≃⋆ₐ[ℂ] A'} {κ₂ : C'.Iso C''} {α₂ : A' ≃⋆ₐ[ℂ] A''}
    (h₁ : IsCovariancePair 𝒜 𝒜' κ₁ α₁) (h₂ : IsCovariancePair 𝒜' 𝒜'' κ₂ α₂) :
    IsCovariancePair 𝒜 𝒜'' (κ₁.trans κ₂) (α₁.trans α₂) :=
  LocalAlgebrasLean.Net.IsCovariancePair.trans h₁ h₂

/-- Milestone A, Lemma 6 (third part): the inverse of a covariance pair. -/
theorem IsCovariancePair.symm {𝒜 : Net R A} {𝒜' : Net R' A'} {κ : C.Iso C'}
    {α : A ≃⋆ₐ[ℂ] A'} (h : IsCovariancePair 𝒜 𝒜' κ α) :
    IsCovariancePair 𝒜' 𝒜 κ.symm α.symm :=
  LocalAlgebrasLean.Net.IsCovariancePair.symm h

end Net

end LinearAQFT
