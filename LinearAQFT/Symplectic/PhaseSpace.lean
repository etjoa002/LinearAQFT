import LinearAQFT.Causal.Basic
import Mathlib.Basic.Real.Basic
import Mathlib.LinearAlgebra.BilinearForm.Properties
import Mathlib.Algebra.Module.Submodule.Map

/-!
# Phase-space data

The classical phase space of a linear field over a causal index: test functions `D` with the
subspaces `loc O` of test functions localized in each region, a phase space `V` with an
alternating form `sigma`, and a surjective linear map `cls : D → V` assigning to each test
function the element of the phase space it generates (for the free field, the solution `E f`).
Causality and time slice are the two conditions under which the net of local algebras
generated by Weyl elements satisfies the corresponding axioms (milestone C, Definition 1).

"Phase-space data" is a term of this library; the standard object is a symplectic space of
solutions together with the test functions localized in each region.

## Main definitions

* `LinearAQFT.Symplectic.PhaseSpace C D V`: phase-space data over the causal index `C`.
* `LinearAQFT.Symplectic.PhaseSpace.Iso`: isomorphisms of phase-space data; the symplectic
  condition excludes the pushforward along a time reversal, except where a sign twist restores it
  (notes, Remark 4.4).
* `PhaseSpace.Iso.refl`, `PhaseSpace.Iso.trans`; `PhaseSpace.Iso.T_eq_of_push` (the symplectic
  map is determined by the map of test functions).
-/

namespace LinearAQFT.Symplectic

open CausalIndex

variable {R : Type*} [Preorder R]

/-- Phase-space data over a causal index (milestone C, Definition 1). -/
structure PhaseSpace (C : CausalIndex R) (D V : Type*) [AddCommGroup D] [Module ℝ D]
    [AddCommGroup V] [Module ℝ V] where
  /-- The test functions localized in each region, monotone in the region. -/
  loc : R →o Submodule ℝ D
  exists_mem_loc : ∀ f : D, ∃ O, f ∈ loc O
  /-- The symplectic form of the phase space. -/
  sigma : LinearMap.BilinForm ℝ V
  isAlt : sigma.IsAlt
  /-- The element `[f]` of the phase space generated by a test function `f`. -/
  cls : D →ₗ[ℝ] V
  cls_surjective : Function.Surjective cls
  /-- (P1) Causality. -/
  causal : ∀ ⦃O₁ O₂ : R⦄, C.Orthogonal O₁ O₂ →
    ∀ f ∈ loc O₁, ∀ g ∈ loc O₂, sigma (cls f) (cls g) = 0
  /-- (P2) Time slice. -/
  timeSlice : ∀ ⦃O O' : R⦄, C.Dependent O O' → ∀ f ∈ loc O, ∃ f' ∈ loc O', cls f' = cls f

namespace PhaseSpace

variable {R' R'' : Type*} [Preorder R'] [Preorder R'']
variable {C : CausalIndex R} {C' : CausalIndex R'} {C'' : CausalIndex R''}
variable {D V D' V' D'' V'' : Type*} [AddCommGroup D] [Module ℝ D] [AddCommGroup V] [Module ℝ V]
  [AddCommGroup D'] [Module ℝ D'] [AddCommGroup V'] [Module ℝ V']
  [AddCommGroup D''] [Module ℝ D''] [AddCommGroup V''] [Module ℝ V'']

/-- An isomorphism of phase-space data (milestone C, Definition 3): an isomorphism of causal
indices, a linear bijection of test functions carrying localized test functions onto localized
test functions, and a symplectic linear bijection of phase spaces compatible with `cls`. -/
structure Iso (Φ : PhaseSpace C D V) (Φ' : PhaseSpace C' D' V') where
  /-- The isomorphism of causal indices. -/
  kappa : C.Iso C'
  /-- The map of test functions. -/
  push : D ≃ₗ[ℝ] D'
  map_loc : ∀ O, (Φ.loc O).map (push : D →ₗ[ℝ] D') = Φ'.loc (kappa O)
  /-- The map of phase spaces. -/
  T : V ≃ₗ[ℝ] V'
  cls_push : ∀ f, Φ'.cls (push f) = T (Φ.cls f)
  symplectic : ∀ u v, Φ'.sigma (T u) (T v) = Φ.sigma u v

/-- Because `cls` is onto, the symplectic map of an isomorphism is determined by its map of test
functions. -/
theorem Iso.T_eq_of_push {Φ : PhaseSpace C D V} {Φ' : PhaseSpace C' D' V'} {e e' : Φ.Iso Φ'}
    (h : e.push = e'.push) : e.T = e'.T := by
  ext u
  obtain ⟨f, rfl⟩ := Φ.cls_surjective u
  rw [← e.cls_push, ← e'.cls_push, h]

/-- Milestone C, Lemma 4: the identity isomorphism. -/
def Iso.refl (Φ : PhaseSpace C D V) : Φ.Iso Φ where
  kappa := CausalIndex.Iso.refl C
  push := LinearEquiv.refl ℝ D
  map_loc O := by simp
  T := LinearEquiv.refl ℝ V
  cls_push _ := rfl
  symplectic _ _ := rfl

/-- Milestone C, Lemma 4: the composite of two isomorphisms, first `e₁` then `e₂`. -/
def Iso.trans {Φ : PhaseSpace C D V} {Φ' : PhaseSpace C' D' V'}
    {Φ'' : PhaseSpace C'' D'' V''} (e₁ : Φ.Iso Φ') (e₂ : Φ'.Iso Φ'') : Φ.Iso Φ'' where
  kappa := e₁.kappa.trans e₂.kappa
  push := e₁.push.trans e₂.push
  map_loc O := by
    rw [show ((e₁.push.trans e₂.push : D ≃ₗ[ℝ] D'') : D →ₗ[ℝ] D'') =
        (e₂.push : D' →ₗ[ℝ] D'') ∘ₗ (e₁.push : D →ₗ[ℝ] D') from rfl,
      Submodule.map_comp, e₁.map_loc, e₂.map_loc]
    rfl
  T := e₁.T.trans e₂.T
  cls_push f := by simp [e₁.cls_push, e₂.cls_push]
  symplectic u v := by simp [e₁.symplectic, e₂.symplectic]

@[simp] theorem Iso.refl_T (Φ : PhaseSpace C D V) :
    (Iso.refl Φ).T = LinearEquiv.refl ℝ V := rfl

@[simp] theorem Iso.trans_T {Φ : PhaseSpace C D V} {Φ' : PhaseSpace C' D' V'}
    {Φ'' : PhaseSpace C'' D'' V''} (e₁ : Φ.Iso Φ') (e₂ : Φ'.Iso Φ'') :
    (e₁.trans e₂).T = e₁.T.trans e₂.T := rfl

theorem Iso.image_loc {Φ : PhaseSpace C D V} {Φ' : PhaseSpace C' D' V'} (e : Φ.Iso Φ')
    (O : R) : (e.push : D → D') '' (Φ.loc O : Set D) = (Φ'.loc (e.kappa O) : Set D') := by
  rw [← e.map_loc O, Submodule.map_coe]
  rfl

end PhaseSpace

end LinearAQFT.Symplectic
