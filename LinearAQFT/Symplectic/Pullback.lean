import BosonicLean.Weyl.Pullback
import LinearAQFT.Symplectic.Net

/-!
# Pullback of a Weyl system and its net

The pullback `W_S ∘ T` of a Weyl system along a surjective symplectic map is
`BosonicLean.Weyl.WeylSystem.pullback` (moved to BosonicLean on 29 Sep 2026, with
`BosonicLean.Weyl.relPhase_comp`). Its net is generated by the `W_S (T [f])`.

## Main statements

* `LinearAQFT.Symplectic.generators_pullback` (E2, Proposition 9).
-/

namespace LinearAQFT

namespace Symplectic

variable {R : Type*} [Preorder R] {C : CausalIndex R}
variable {D V VS : Type*} [AddCommGroup D] [Module ℝ D] [AddCommGroup V] [Module ℝ V]
  [AddCommGroup VS] [Module ℝ VS]
variable {A : Type*} [CStarAlgebra A]

/-- E2, Proposition 9: the net of the pullback is generated by the `W_S (T [f])`. -/
theorem generators_pullback (Φ : PhaseSpace C D V) {σS : LinearMap.BilinForm ℝ VS}
    (S : BosonicLean.Weyl.WeylSystem σS A) (T : V →ₗ[ℝ] VS)
    (hT : ∀ u w, σS (T u) (T w) = Φ.sigma u w)
    (hsurj : Function.Surjective T) (O : R) :
    generators Φ (S.pullback T hT hsurj) O =
      (fun f => S.W (T (Φ.cls f))) '' (Φ.loc O : Set D) :=
  rfl

end Symplectic

end LinearAQFT
