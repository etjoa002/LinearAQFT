import LinearAQFT.Symplectic.PhaseSpace
import LinearAQFT.Net.Generated
import BosonicLean.Weyl.Relabel

/-!
# The net of local algebras of a classical phase space

For phase-space data `Φ` and a Weyl system `S` over `(V, sigma)`, the local algebra of a region
`O` is the C*-algebra generated by the Weyl elements `W [f]` of the test functions `f`
localized in `O`. This net satisfies isotony, generation, causality and time slice for every
Weyl system (Axioms 1, 3, 4 of Dimock, Commun. Math. Phys. 77 (1980) 219–228). Covariance holds
for Weyl systems related by a star isomorphism, and for the CCR algebra the relabelling
isomorphisms form a functorial assignment (Axiom 5 of the same paper).

## Main statements

* `weylNet_isGenerating`, `weylNet_isCausal`, `weylNet_hasTimeSlice` (milestone C, Theorem 6).
* `weylNet_isCovariancePair` (Theorem 7) and `weylNet_isomorphic` (Corollary 8).
* `ccrNet_isCovariancePair`, `ccrAlpha_refl`, `ccrAlpha_trans` (Theorem 10).
-/

namespace LinearAQFT.Symplectic

open CausalIndex Net BosonicLean.Weyl

variable {R R' R'' : Type*} [Preorder R] [Preorder R'] [Preorder R'']
variable {C : CausalIndex R} {C' : CausalIndex R'} {C'' : CausalIndex R''}
variable {D V D' V' D'' V'' : Type*} [AddCommGroup D] [Module ℝ D] [AddCommGroup V] [Module ℝ V]
  [AddCommGroup D'] [Module ℝ D'] [AddCommGroup V'] [Module ℝ V']
  [AddCommGroup D''] [Module ℝ D''] [AddCommGroup V''] [Module ℝ V'']
variable {A A' : Type*} [CStarAlgebra A] [CStarAlgebra A']

/-- Milestone C, Definition 5: the generators `G(O) = {W [f] : f ∈ loc O}`. -/
def generators (Φ : PhaseSpace C D V) (S : WeylSystem Φ.sigma A) : R →o Set A where
  toFun O := (fun f => S.W (Φ.cls f)) '' (Φ.loc O : Set D)
  monotone' _ _ h := Set.image_mono (Φ.loc.monotone h)

theorem generators_apply (Φ : PhaseSpace C D V) (S : WeylSystem Φ.sigma A) (O : R) :
    generators Φ S O = (fun f => S.W (Φ.cls f)) '' (Φ.loc O : Set D) := rfl

/-- Milestone C, Definition 5: the net of the Weyl system `S`. -/
def weylNet (Φ : PhaseSpace C D V) (S : WeylSystem Φ.sigma A) : Net R A :=
  Net.generated (generators Φ S)

theorem iUnion_generators (Φ : PhaseSpace C D V) (S : WeylSystem Φ.sigma A) :
    ⋃ O, generators Φ S O = Set.range S.W := by
  ext a
  simp only [Set.mem_iUnion, generators_apply, Set.mem_image, SetLike.mem_coe, Set.mem_range]
  constructor
  · rintro ⟨O, f, -, rfl⟩
    exact ⟨Φ.cls f, rfl⟩
  · rintro ⟨u, rfl⟩
    obtain ⟨f, rfl⟩ := Φ.cls_surjective u
    obtain ⟨O, hO⟩ := Φ.exists_mem_loc f
    exact ⟨O, f, hO, rfl⟩

/-- Milestone C, Theorem 6: generation. -/
theorem weylNet_isGenerating (Φ : PhaseSpace C D V) (S : WeylSystem Φ.sigma A) :
    (weylNet Φ S).IsGenerating := by
  apply generated_isGenerating
  rw [iUnion_generators]
  exact S.generating

/-- Milestone C, Theorem 6: causality. -/
theorem weylNet_isCausal (Φ : PhaseSpace C D V) (S : WeylSystem Φ.sigma A) :
    IsCausal C (weylNet Φ S) := by
  apply generated_isCausal
  rintro O₁ O₂ hO _ ⟨f, hf, rfl⟩ _ ⟨g, hg, rfl⟩
  refine ⟨S.commute_of_eq_zero Φ.isAlt (Φ.causal hO f hf g hg), ?_⟩
  rw [S.star_eq Φ.isAlt, ← map_neg]
  exact S.commute_of_eq_zero Φ.isAlt (Φ.causal hO f hf (-g) (neg_mem hg))

/-- Milestone C, Theorem 6: time slice. -/
theorem weylNet_hasTimeSlice (Φ : PhaseSpace C D V) (S : WeylSystem Φ.sigma A) :
    HasTimeSlice C (weylNet Φ S) := by
  apply generated_hasTimeSlice
  rintro O O' hO _ ⟨f, hf, rfl⟩
  obtain ⟨f', hf', he⟩ := Φ.timeSlice hO f hf
  simp only
  rw [← he]
  exact subset_generated (generators Φ S) O' ⟨f', hf', rfl⟩

/-- Milestone C, Theorem 7: a star isomorphism of Weyl systems compatible with an isomorphism
of phase-space data gives a covariance pair of their nets. -/
theorem weylNet_isCovariancePair {Φ : PhaseSpace C D V} {Φ' : PhaseSpace C' D' V'}
    (e : Φ.Iso Φ') (S : WeylSystem Φ.sigma A) (S' : WeylSystem Φ'.sigma A')
    (α : A ≃⋆ₐ[ℂ] A') (hα : ∀ u, α (S.W u) = S'.W (e.T u)) :
    IsCovariancePair (weylNet Φ S) (weylNet Φ' S') e.kappa α := by
  apply generated_isCovariancePair
  intro O
  rw [generators_apply, generators_apply, ← e.image_loc O, Set.image_image, Set.image_image]
  congr 1
  funext f
  rw [hα, e.cls_push]

/-- Milestone C, Corollary 8: Weyl systems over the same phase space related by a star
isomorphism `α` with `α ∘ W = W'` have isomorphic nets. -/
theorem weylNet_isomorphic (Φ : PhaseSpace C D V) (S : WeylSystem Φ.sigma A)
    (S' : WeylSystem Φ.sigma A') (α : A ≃⋆ₐ[ℂ] A') (hα : ∀ u, α (S.W u) = S'.W u) :
    Isomorphic C (weylNet Φ S) (weylNet Φ S') :=
  ⟨α, weylNet_isCovariancePair (PhaseSpace.Iso.refl Φ) S S' α hα⟩

/-- Milestone C, Definition 9: the net of the concrete CCR algebra. -/
noncomputable def ccrNet (Φ : PhaseSpace C D V) : Net R (CCR Φ.sigma) :=
  weylNet Φ (CCR.weylSystem Φ.sigma Φ.isAlt)

/-- Milestone C, Definition 9: the `*`-isomorphism `α_θ` of an isomorphism `θ` of phase-space data,
conjugation by the relabelling unitary of its symplectic map. -/
noncomputable def ccrAlpha {Φ : PhaseSpace C D V} {Φ' : PhaseSpace C' D' V'}
    (e : Φ.Iso Φ') : CCR Φ.sigma ≃⋆ₐ[ℂ] CCR Φ'.sigma :=
  CCR.relabel e.symplectic

/-- Milestone C, Theorem 10: `(κ, α_Φ)` is a covariance pair of the CCR nets. -/
theorem ccrNet_isCovariancePair {Φ : PhaseSpace C D V} {Φ' : PhaseSpace C' D' V'}
    (e : Φ.Iso Φ') : IsCovariancePair (ccrNet Φ) (ccrNet Φ') e.kappa (ccrAlpha e) :=
  weylNet_isCovariancePair e _ _ (ccrAlpha e) fun u =>
    Subtype.ext (conj_relabel_weyl e.symplectic u)

/-- Milestone C, Theorem 10: `α_id = id`. -/
theorem ccrAlpha_refl (Φ : PhaseSpace C D V) :
    ccrAlpha (PhaseSpace.Iso.refl Φ) = StarAlgEquiv.refl (R := ℂ) (A := CCR Φ.sigma) :=
  CCR.relabel_refl

/-- Milestone C, Theorem 10: `α_{Φ₂ ∘ Φ₁} = α_{Φ₂} ∘ α_{Φ₁}`. -/
theorem ccrAlpha_trans {Φ : PhaseSpace C D V} {Φ' : PhaseSpace C' D' V'}
    {Φ'' : PhaseSpace C'' D'' V''} (e₁ : Φ.Iso Φ') (e₂ : Φ'.Iso Φ'') :
    ccrAlpha (e₁.trans e₂) = (ccrAlpha e₁).trans (ccrAlpha e₂) :=
  CCR.relabel_trans e₁.symplectic e₂.symplectic

/-- The isomorphism `α_θ` depends on `θ` only through its symplectic map `T`. -/
theorem ccrAlpha_congr {Φ : PhaseSpace C D V} {Φ' : PhaseSpace C' D' V'} {e e' : Φ.Iso Φ'}
    (h : e.T = e'.T) : ccrAlpha e = ccrAlpha e' := by
  have key : ∀ (T T' : V ≃ₗ[ℝ] V') (hT : ∀ u v, Φ'.sigma (T u) (T v) = Φ.sigma u v)
      (hT' : ∀ u v, Φ'.sigma (T' u) (T' v) = Φ.sigma u v), T = T' →
      CCR.relabel hT = CCR.relabel hT' := by
    rintro _ _ _ _ rfl; rfl
  exact key _ _ e.symplectic e'.symplectic h

section Group

variable {Γ : Type*} [Group Γ] {Φ : PhaseSpace C D V}

/-- A family `γ ↦ e γ` of automorphisms of phase-space data whose symplectic maps compose as a
group action gives the homomorphism `γ ↦ α_{e γ}` into the automorphisms of the CCR algebra. -/
noncomputable def ccrAlphaHom (e : Γ → Φ.Iso Φ) (h1 : (e 1).T = LinearEquiv.refl ℝ V)
    (hmul : ∀ γ γ', (e (γ * γ')).T = (e γ').T.trans (e γ).T) :
    Γ →* (CCR Φ.sigma ≃⋆ₐ[ℂ] CCR Φ.sigma) where
  toFun γ := ccrAlpha (e γ)
  map_one' := (ccrAlpha_congr (e' := PhaseSpace.Iso.refl Φ) h1).trans (ccrAlpha_refl Φ)
  map_mul' γ γ' :=
    ((ccrAlpha_congr (e' := (e γ').trans (e γ)) (hmul γ γ')).trans (ccrAlpha_trans _ _)).trans
      (StarAlgEquiv.ext fun _ => rfl)

@[simp] theorem ccrAlphaHom_apply (e : Γ → Φ.Iso Φ) (h1 : (e 1).T = LinearEquiv.refl ℝ V)
    (hmul : ∀ γ γ', (e (γ * γ')).T = (e γ').T.trans (e γ).T) (γ : Γ) :
    ccrAlphaHom e h1 hmul γ = ccrAlpha (e γ) := rfl

/-- A group acting on phase-space data by isomorphisms, with a homomorphic action `κ` on the
regions and symplectic maps composing as a group action, acts on the CCR algebra, and the CCR
net is covariant. -/
theorem ccrNet_isCovariantUnder (e : Γ → Φ.Iso Φ) (h1 : (e 1).T = LinearEquiv.refl ℝ V)
    (hmul : ∀ γ γ', (e (γ * γ')).T = (e γ').T.trans (e γ).T) (κ : Γ →* C.Aut)
    (hκ : ∀ γ, (e γ).kappa = κ γ) :
    IsCovariantUnder (ccrNet Φ) κ (ccrAlphaHom e h1 hmul) := fun γ => by
  have h := ccrNet_isCovariancePair (e γ)
  rw [hκ γ, ← ccrAlphaHom_apply e h1 hmul] at h
  exact h

end Group

end LinearAQFT.Symplectic
